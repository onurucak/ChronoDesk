<UserControl x:Class="ChronoDesk.UI.Views.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             x:Name="RootControl">
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Horizontal Timer Bar -->
            <RowDefinition Height="*"/>    <!-- Recent Sessions -->
        </Grid.RowDefinitions>

        <!-- Horizontal Timer Bar -->
        <Border Grid.Row="0" Margin="0,0,0,30" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="10" MinHeight="60" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>     <!-- Description -->
                    <ColumnDefinition Width="Auto"/>  <!-- Project -->
                    <ColumnDefinition Width="Auto"/>  <!-- Separator -->
                    <ColumnDefinition Width="Auto"/>  <!-- Timer -->
                    <ColumnDefinition Width="Auto"/>  <!-- Button -->
                </Grid.ColumnDefinitions>

                <!-- Description Input -->
                <Grid Margin="0,0,15,0">
                    <TextBox Text="{Binding CurrentNotes, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalAlignment="Center" 
                             BorderThickness="0" 
                             Background="Transparent" 
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="White"
                             FontSize="15"
                             Padding="5">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding UpdateNotesCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="What are you working on?" 
                               IsHitTestVisible="False" 
                               VerticalAlignment="Center" 
                               Margin="8,0,0,0" 
                               Foreground="#666"
                               FontSize="15">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentNotes}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Project Selector -->
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Projects}" 
                          SelectedItem="{Binding SelectedProject}" 
                          DisplayMemberPath="Name" 
                          Width="180"
                          Height="35"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0"
                          Style="{StaticResource {x:Type ComboBox}}"/>

                <!-- Separator -->
                <Border Grid.Column="2" Width="1" Height="30" Background="#333" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <!-- Timer Display -->
                <TextBlock Grid.Column="3" 
                           Text="{Binding CurrentDuration}" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,20,0"
                           FontFamily="Consolas"/>

                <!-- Start/Stop Button -->
                <Button Grid.Column="4" 

                        Width="100"
                        Height="40"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold">
                     <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                             <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                    <Setter Property="Content" Value="STOP"/>
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="Command" Value="{Binding StopCommand}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTimerRunning}" Value="False">
                                    <Setter Property="Content" Value="START"/>
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Command" Value="{Binding StartCommand}"/>
                                </DataTrigger>
                             </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Recent Sessions List -->
        <Border Grid.Row="1" Margin="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                 <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Recent Sessions" Style="{StaticResource H2}" Margin="0,0,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Text="Henüz bir kayıt bulunamadı" 
                           Grid.Row="1"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Top" 
                           Margin="0,50,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="16"
                           Visibility="{Binding IsRecentSessionsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <ListView Grid.Row="1" ItemsSource="{Binding RecentSessions}" BorderThickness="0" Background="Transparent" Margin="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2A2A2A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>     <!-- Description/Notes -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Project -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Tags/Billable (Placeholder) -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Time Range -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Date -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Duration -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Actions -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Description / Notes -->
                                    <TextBlock Text="{Binding Notes, TargetNullValue='(No description)'}" 
                                               VerticalAlignment="Center" 
                                               Foreground="#DDDDDD" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="0,0,10,0"/>

                                    <!-- Project -->
                                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal">
                                             <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                                             <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Time Range (Start - End) -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding StartTime, StringFormat='HH:mm'}" Foreground="#AAAAAA"/>
                                        <TextBlock Text=" - " Foreground="#777"/>
                                        <TextBlock Text="{Binding EndTime, StringFormat='HH:mm', TargetNullValue='Now'}" Foreground="#AAAAAA"/>
                                    </StackPanel>
                                    
                                    <!-- Date Icon + Date -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#777" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StartTime, StringFormat='MMM dd'}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="5" Text="{Binding Duration, Converter={StaticResource TimeSpanToDurationConverter}}" 
                                               FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextBrush}" 
                                               VerticalAlignment="Center" Margin="0,0,20,0"/>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        
                                        <Button Command="{Binding DataContext.EditSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" ToolTip="Edit Session" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#AAAAAA"/>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#333"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        
                                        <Button Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" ToolTip="Delete Session">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#AAAAAA"/>
                                             <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                     <DataTrigger Binding="{Binding EndTime}" Value="{x:Null}">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.2"/>
                                                                        <Setter Property="ToolTip" Value="Cannot delete active session"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#333"/>
                                                                        <Setter Property="TextBlock.Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>